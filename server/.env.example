# Server Configuration
PORT=5000
NODE_ENV=production

# Client URL (for CORS) - Your Vercel frontend URL
CLIENT_URL=https://your-app.vercel.app

# OpenAI API Key (NEVER commit this)
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Connection String (optional for MVP)
MONGODB_URI=mongodb://localhost:27017/projectforge
